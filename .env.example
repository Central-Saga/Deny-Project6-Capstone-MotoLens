# ==============================================================================
# MotoLens Root Docker Environment Configuration (.env.example)
# ==============================================================================
# Salin file ini ke `.env` sebelum menjalankan `docker compose up -d`:
#   cp .env.example .env
#
# Generate APP_KEY baru dengan salah satu perintah berikut:
#   docker compose run --rm backend php artisan key:generate --show
#   atau:
#   openssl rand -base64 32   (tambahkan prefix base64: di depannya)
# ==============================================================================

APP_NAME=MotoLens
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8000

# PostgreSQL Container & Laravel DB Credentials (Wajib identik & kuat)
POSTGRES_USER=postgres
POSTGRES_DB=motolens
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=motolens
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
